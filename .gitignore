# ==========================================================================
# FILE LOCATION:  flashdecode/.gitignore
# ==========================================================================

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# --- compiled CUDA extension ---
# kernels/build/ holds .o files (tens of MB) and the .so is a build product.
# Both are regenerated by:  cd kernels && python setup.py build_ext --inplace
kernels/build/
*.so
*.o
*.ptx
*.cubin

# --- generated ground truth ---
# reference/oracle.pt is an activation dump. It is small for Qwen2.5-1.5B at a
# 5-token prompt (~2 MB), but it scales with layers x prompt length x hidden,
# and a longer parity prompt or a bigger model pushes it into the hundreds of
# MB. It is reproducible in one command, so it never belongs in git:
#     python -m reference.oracle
reference/oracle.pt
reference/*.pt

# --- profiler output ---
# These are the real 100 MB+ risk in this project. A single `ncu --set full`
# report can exceed 100 MB, which GitHub rejects outright, and once a large
# blob is in history it stays there unless you rewrite it.
*.ncu-rep
*.nsys-rep
*.qdrep
*.sqlite
*.nvvp

# --- model weights, just in case ---
# Normally these live in ~/.cache/huggingface, but guard against a stray
# local download.
*.safetensors
*.bin
*.gguf
models/

# --- scratch ---
scratch/
tmp/
*.log
nohup.out